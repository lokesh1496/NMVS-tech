# Copy to .env for local development and fill in real values.
# Do not commit .env or share secrets/screenshots.

DB_TYPE=sqlite
# Optional: if set, this takes precedence over DB_TYPE.
# DATABASE_URL=sqlite:///./nmvs.db

NMVS_ENVIRONMENT=development
NMVS_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
NMVS_AGENT_TOKEN=replace_with_a_random_agent_token_at_least_32_characters

DEVICE_MONITOR_INTERVAL=30
NMVS_ENABLE_MONITORING_SCHEDULER=true

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
